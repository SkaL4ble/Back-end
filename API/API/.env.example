# ==========================================
# BANCO DE DADOS
# ==========================================

#CONNECTION_STRING=Server=[NOME DO SERVIDOR];Database=SkaL4ble;Trusted_Connection=True;TrustServerCertificate=True

# ==========================================
# AUTENTICAÇÃO JWT
# ==========================================

# Use uma chave secreta robusta de pelo menos 32 caracteres
#JWT_KEY=[Ex: "UMA_CHAVE_SECRETA_SUPER_SEGURA_COM_MIN_DE_32_CHARS"]

#JWT_ISSUER=Skal4bleAPI [Ou nome de sua preferencia]

#JWT_AUDIENCE=Skal4bleClient [Ou nome de sua preferencia]

# Defina o tempo de expiração do token em minutos
#JWT_EXPIRA_EM_MINUTOS=[Ex: "120"]

# ==========================================
# SONARQUBE
# ==========================================
#Use a URL do seu servidor SonarQube
#SonarQube__UrlBase=http://localhost:9000
# Use o token de serviço gerado no SonarQube para autenticação
#SonarQube__Token=squ_token_de_servico